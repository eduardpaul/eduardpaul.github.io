---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CvImage from '../components/CvImage.astro';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../config';
import cv from '../data/cv';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  /** The author card is hidden on the homepage, as it was under Gatsby. */
  showAuthorCard?: boolean;
}

const { title, description, image, keywords } = Astro.props;

const isRootPath = Astro.url.pathname === '/';
const showAuthorCard = Astro.props.showAuthorCard ?? !isRootPath;

const { profile } = cv.aboutMe;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <Seo title={title} description={description} image={image} keywords={keywords} />
    <noscript>
      <style>
        /* Without JS nothing ever adds .is-visible, so reveal everything. */
        .anim {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <div
      data-is-root-path={isRootPath}
      class="min-h-screen flex flex-col bg-gray-50 text-gray-800 antialiased"
    >
      <Header />

      <div class="flex-1 bg-slate-50 text-slate-800">
        <main><slot /></main>
      </div>

      {
        showAuthorCard && (
          <section class="bg-white shadow-sm rounded-xl mx-auto max-w-6xl my-6 px-6 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
              <CvImage
                imageObject={profile.avatar}
                alt={`${profile.name} ${profile.surnames}`}
                width={100}
                class="w-24 h-24 rounded-full shadow-md object-cover mx-auto sm:mx-0"
              />
              <div class="text-center sm:text-left">
                {/* Not an h1: this card repeats on every non-home page, and a
                    post or /about already has its own. The classes set the
                    size, so it renders identically. */}
                <p class="text-xl font-bold text-gray-900">
                  {profile.name} {profile.surnames}
                </p>
                <p class="text-blue-600 font-medium text-sm">{profile.title}</p>
                <p class="text-gray-600 text-sm mt-2">{SITE.description}</p>
              </div>
            </div>

            <div class="flex justify-center md:justify-end">
              <a
                href="/about"
                class="bg-blue-600 text-white font-semibold px-5 py-2 rounded-full hover:bg-blue-700 transition"
              >
                Learn more
              </a>
            </div>
          </section>
        )
      }

      <Footer />
    </div>
  </body>
</html>
