---
import AnimatedSection from './AnimatedSection.astro';
import ReadMore from './ReadMore.astro';
import CvImage from './CvImage.astro';
import cv from '../data/cv';

const { profile } = cv.aboutMe;
---
<section id="bio" class="container mx-auto px-6 py-12">
  <AnimatedSection>
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-center">
      <div class="md:col-span-2 flex justify-center">
        <CvImage
          imageObject={profile.avatar}
          alt={`${profile.name} ${profile.surnames}`}
          width={400}
          loading="eager"
          class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover shadow-xl ring-4 ring-white"
        />
      </div>
      <div class="md:col-span-3 text-center md:text-left">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight">
          {profile.name} {profile.surnames}
        </h1>
        <h2 class="mt-2 text-xl md:text-2xl font-semibold text-blue-600">
          {profile.title}
        </h2>
        <ReadMore initialMaxHeight="max-h-40">
          <p class="mt-6 text-lg text-slate-600 whitespace-pre-line">{profile.description}</p>
        </ReadMore>
      </div>
    </div>
  </AnimatedSection>
</section>
