---
import AnimatedSection from './AnimatedSection.astro';
import PostCard from './PostCard.astro';
import Search from './Search.astro';
import { getPosts } from '../lib/posts';

// The homepage is a preview -- "a glimpse into my latest posts" -- so it
// shows the most recent few and sends the rest to /activity. Search is
// unaffected: Pagefind queries the whole archive, not just what is rendered
// here.
const LIMIT = 6;

const posts = await getPosts();
const preview = posts.slice(0, LIMIT);
const hasMore = posts.length > LIMIT;

const GRID = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8';
---
<section id="online-activity" class="py-12 bg-slate-50">
  <div class="container mx-auto px-6">
    <AnimatedSection>
      <div class="text-center mb-16">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">My Online Activity</h2>
        <p class="mt-4 text-lg text-slate-600">
          A glimpse into my latest posts, shares, and insights.
        </p>
      </div>
    </AnimatedSection>

    <Search
      gridClass={GRID}
      wrapperClass="max-w-md mx-auto mb-10"
      inputClass="w-full rounded-full border border-slate-300 py-2.5 px-5 pr-10 text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600 shadow-sm"
      icon
    >
      <div>
        <div class={GRID}>
          {
            preview.map((post) => (
              <AnimatedSection>
                <PostCard post={post} cta />
              </AnimatedSection>
            ))
          }
        </div>

        {/* Inside the slot, so it disappears with the list while results are
            showing rather than sitting under them. */}
        {
          hasMore && (
            <div class="mt-10 text-center">
              <a
                href="/activity"
                class="inline-flex items-center gap-2 rounded-full bg-blue-600 text-white font-semibold px-6 py-2.5 hover:bg-blue-700 transition"
              >
                View all {posts.length} posts
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"
                  />
                </svg>
              </a>
            </div>
          )
        }
      </div>
    </Search>
  </div>
</section>
