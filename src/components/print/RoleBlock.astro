---
import BulletList from './BulletList.astro';
import { formatPrintDate } from '../../lib/print';
import cv from '../../data/cv';

type Job = (typeof cv.experience.jobs)[number];
type Role = Job['roles'][number];

interface Props {
  job: Job;
  role: Role;
}

const { job, role } = Astro.props;

// A current role omits finishDate entirely.
const finishDate = 'finishDate' in role ? role.finishDate : null;
---
<div style={{ marginBottom: '14px', pageBreakInside: 'avoid', breakInside: 'avoid' }}>
  <div
    style={{
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'flex-start',
      marginBottom: '3px',
    }}
  >
    <div>
      <p style={{ margin: '0', fontSize: '12px', fontWeight: '700', color: '#0f172a' }}>
        {role.name}
      </p>
      <p style={{ margin: '0', fontSize: '11px', fontWeight: '600', color: '#2563eb' }}>
        {job.organization.name}
      </p>
    </div>
    <span
      style={{
        fontSize: '10px',
        color: '#64748b',
        whiteSpace: 'nowrap',
        marginLeft: '8px',
        paddingTop: '2px',
      }}
    >
      {formatPrintDate(role.startDate)} – {formatPrintDate(finishDate)}
    </span>
  </div>
  {role.challenges.map((challenge) => <BulletList text={challenge.description} />)}
</div>
