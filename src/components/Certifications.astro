---
import AnimatedSection from './AnimatedSection.astro';
import CvImage from './CvImage.astro';
import cv from '../data/cv';

const certifications = cv.knowledge.studies
  .filter((study) => study.studyType === 'certification')
  .sort((a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime());
---
<section id="certifications" class="py-12">
  <div class="container mx-auto px-6">
    <AnimatedSection>
      <div class="text-center mb-16">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">
          Certifications &amp; Education
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          My commitment to continuous learning and professional development.
        </p>
      </div>
    </AnimatedSection>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
      {
        certifications.map((cert) => (
          <AnimatedSection class="h-full">
            <a
              href={cert.institution.URL}
              target="_blank"
              rel="noopener noreferrer"
              class="block group h-full"
              aria-label={`Verify certification: ${cert.name}`}
            >
              <div class="bg-white p-6 rounded-2xl shadow-md border border-slate-100 text-center transition-transform duration-300 group-hover:-translate-y-2 group-hover:shadow-lg h-full flex flex-col">
                <div class="flex-grow flex items-center justify-center">
                  <CvImage
                    imageObject={cert.institution.image}
                    alt={cert.institution.name}
                    width={200}
                    class="h-24 max-h-full object-contain"
                  />
                </div>
                <h3 class="font-bold text-slate-800 text-md group-hover:text-blue-600 mt-4">
                  {cert.name}
                </h3>
                <p class="text-sm text-slate-500 mt-1">{cert.institution.name}</p>
              </div>
            </a>
          </AnimatedSection>
        ))
      }
    </div>
  </div>
</section>
