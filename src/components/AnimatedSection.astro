---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<div class:list={['anim', className]}>
  <slot />
</div>

<script>
  // One observer per page for every .anim block, replacing the per-component
  // useIntersectionObserver hook. Each element is unobserved once revealed, so
  // the animation never re-runs.
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    },
    { threshold: 0.1 },
  );

  for (const el of document.querySelectorAll('.anim')) io.observe(el);
</script>
