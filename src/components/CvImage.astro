---
// Mirrors the old core/cvimage.js: optimized image for rasters, plain <img>
// for SVGs, nothing at all when the CV has no image for that entry.
//
// Both kinds are pulled into the repo by scripts/fetch-media.mjs, keyed by the
// filename at the end of the cv.json `link`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imageObject?: { link?: string; alt?: string } | null;
  alt?: string;
  class?: string;
  width?: number;
  loading?: 'lazy' | 'eager';
}

// Eager so the lookup is a plain object access; these are metadata records,
// not the image bytes.
const rasters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/cv-media/*.webp', {
  eager: true,
});

const {
  imageObject,
  alt,
  class: className = 'h-24 w-24 mx-auto mb-4 object-contain',
  width = 400,
  loading = 'lazy',
} = Astro.props;

const link = imageObject?.link;
const label = alt ?? imageObject?.alt ?? '';
const isSvg = typeof link === 'string' && link.toLowerCase().endsWith('.svg');

// Must agree with `cacheName` in scripts/fetch-media.mjs: SVGs keep their
// filename, rasters are re-encoded to .webp.
const file = link?.split('/').pop();
const svgSrc = isSvg && file ? `/cv-media/${file}` : null;
const raster =
  !isSvg && file
    ? rasters[`/src/assets/cv-media/${file.replace(/\.[^.]+$/, '')}.webp`]?.default
    : undefined;

if (link && !svgSrc && !raster) {
  throw new Error(
    `CvImage: no local file for ${link}. Run \`npm run prebuild\` to download cv.json's media.`,
  );
}
---
{
  raster && (
    <Image
      src={raster}
      alt={label}
      class={className}
      width={Math.min(width, raster.width)}
      loading={loading}
      decoding="async"
    />
  )
}
{svgSrc && <img src={svgSrc} alt={label} class={className} loading={loading} decoding="async" />}
