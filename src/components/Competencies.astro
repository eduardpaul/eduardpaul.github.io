---
import AnimatedSection from './AnimatedSection.astro';
import MarkdownParser from './MarkdownParser.astro';
import cv from '../data/cv';

// Shortest first, so the two-column grid stays roughly balanced.
const facts = [...cv.aboutMe.interestingFacts].sort((a, b) => a.fact.length - b.fact.length);
---
<section id="competencies" class="bg-white py-12">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        facts.map((fact) => (
          <AnimatedSection>
            <div class="bg-slate-50 p-8 h-full flex flex-col rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
              <h3 class="flex items-center text-xl font-bold text-blue-700 mb-4">{fact.topic}</h3>
              <MarkdownParser text={fact.fact} />
            </div>
          </AnimatedSection>
        ))
      }
    </div>
  </div>
</section>
